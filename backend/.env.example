# Same variable names as the Node API (server/.env.example), so existing hosting config carries over.
NODE_ENV=development
PORT=4000
# Prisma-style URLs are accepted as-is (postgresql://user:pass@host:port/db?schema=public&sslmode=require).
DATABASE_URL=postgresql://weather:weather@localhost:5432/weather?schema=public
DB_POOL_SIZE=5
# Comma-separated. Production must include the Vercel frontend origin.
CORS_ORIGINS=http://localhost:5173
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Production: long random secrets (min 32 chars each). Must equal the Node API's values to keep sessions valid.
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars-min
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars-min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_COOKIE_NAME=refreshToken
BCRYPT_SALT_ROUNDS=12
# Optional — if empty/placeholder, free Open-Meteo weather data is used
VISUAL_CROSSING_API_KEY=
VISUAL_CROSSING_BASE_URL=https://weather.visualcrossing.com/VisualCrossingWebServices/rest/services/timeline
VISUAL_CROSSING_UNIT_GROUP=metric
OPEN_METEO_AIR_QUALITY_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
OPEN_METEO_FORECAST_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_GEOCODING_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Optional — enables Temperature/Rain/Wind/Pressure/Clouds tile overlays on the map
OPENWEATHER_API_KEY=
# Upstream HTTP limits and cache lifetimes (ISO-8601 or 4s / 5m / 6h style)
UPSTREAM_CONNECT_TIMEOUT=4s
UPSTREAM_READ_TIMEOUT=8s
WEATHER_CACHE_TTL=5m
GEOCODING_CACHE_TTL=6h
# Requests per minute per client IP (0 disables): login/register, and the public weather/location routes
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_PUBLIC_PER_MINUTE=300

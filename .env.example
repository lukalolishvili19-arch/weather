# Frontend API base URL (optional)
# Local default: http://localhost:4000/api/v1
# Production (Vercel): set to your hosted API, e.g. https://weather-api.onrender.com/api/v1
VITE_API_URL=http://localhost:4000/api/v1

# Tip: during `npm run dev`, Vite also proxies /api → http://localhost:4000
# so you can alternatively use:
# VITE_API_URL=/api/v1
